# Node modules and logs
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build output
/.next/
/out/
/dist/
/out-tsc/
/tmp/
/coverage/

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Local database + uploaded files storage (never commit)
/storage/

# Environment files — never commit secrets
.env
.env.local
.env.*.local

# OS / editor noise
.DS_Store
*.log

# NOTE: lockfiles (package-lock.json) ARE committed on purpose.
# Reproducible installs + Dependabot/npm-audit supply-chain scanning
# depend on the lockfile being in version control.
