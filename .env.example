# ── EduReach NG · environment configuration ────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Database
# Development uses an embedded SQLite database via Node's built-in driver.
# The data layer (src/lib/db.ts) exposes a minimal query interface so the
# engine can be swapped for PostgreSQL in production.
DATABASE_URL="file:storage/edureach.db"

# Secret used for internal token peppering. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Seed accounts (development only — used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@edureach.ng"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_DEMO_EMAIL="demo.student@edureach.ng"
SEED_DEMO_PASSWORD="Student123!"

# Directory for uploaded resource files (kept out of git, served only via API)
STORAGE_DIR="storage/uploads"

# ── Future integrations (not required for MVP) ──────────────────────────────
# EMAIL_PROVIDER="smtp|resend|postmark"
# EMAIL_API_KEY=""
# EMAIL_FROM="EduReach NG <no-reply@edureach.ng>"
# ANALYTICS_KEY=""
# AI_PROVIDER="template"    # template | retrieval | openai | gemini | claude | local
# AI_API_KEY=""
